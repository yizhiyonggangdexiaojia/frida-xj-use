#!/bin/sh

set -eu

device_binary=${FRIDA_DEVICE_BINARY:-/data/local/tmp/tsfs}
host_port=${FRIDA_HOST_PORT:-27042}
serial=${ANDROID_SERIAL:-}
pid_file=/data/local/tmp/.fsrv-usb.pid
log_file=/data/local/tmp/.fsrv-usb.log

usage()
{
  echo "Usage: $0 [--activate UUID]" >&2
  exit 2
}

adb_path=$(command -v adb || true)
[ -n "$adb_path" ] || {
  echo "adb was not found in PATH" >&2
  exit 1
}

run_adb()
{
  if [ -n "$serial" ]; then
    "$adb_path" -s "$serial" "$@"
  else
    "$adb_path" "$@"
  fi
}

if [ "$#" -eq 2 ] && [ "$1" = "--activate" ]; then
  echo "Running: $device_binary --activate $2"
  run_adb shell "su -c '\"$device_binary\" --activate \"$2\"'"
  exit 0
fi

[ "$#" -eq 0 ] || usage

echo "Running: $device_binary --authorize-kpm"
run_adb shell "su -c '\"$device_binary\" --authorize-kpm'"

pid=$(run_adb shell "su -c 'cat \"$pid_file\" 2>/dev/null || true'" |
  tr -d '\r' |
  awk 'NR == 1 { print $1 }')
[ -n "$pid" ] && run_adb shell "su -c 'kill \"$pid\" 2>/dev/null || true'" >/dev/null
run_adb forward --remove "tcp:$host_port" >/dev/null 2>&1 || true
run_adb shell "su -c 'rm -f \"$pid_file\" \"$log_file\"'" >/dev/null

socket_name=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
run_adb shell "su -c 'nohup \"$device_binary\" --listen \"unix:$socket_name\" >\"$log_file\" 2>&1 & echo \$! >\"$pid_file\"'"
run_adb forward "tcp:$host_port" "localabstract:$socket_name" >/dev/null

sleep 1
if ! run_adb shell "su -c 'grep -Fq \"@$socket_name\" /proc/net/unix'" >/dev/null 2>&1; then
  run_adb shell "su -c 'cat \"$log_file\"'" >&2 || true
  exit 1
fi

echo "Frida USB transport is ready on 127.0.0.1:$host_port"
echo "Device binary: $device_binary"
